# AWS Configuration for S3 uploads
# Copy this file to .env and fill in your actual values

# AWS Credentials (required)
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# AWS Region (required)
AWS_REGION=YOUR_AWS_REGION

# AWS Endpoint (for Scaleway S3)
AWS_ENDPOINT_URL=YOUR_AWS_ENDPOINT_URL

# S3 Buckets (required)
AWS_S3_DELIVERABLES_BUCKET=bots-deliverables
AWS_S3_AUDIO_BUCKET=local-meeting-baas-audio
AWS_S3_LOGS_BUCKET=meeting-baas-logs

# Optional: Node environment
NODE_ENV=local
