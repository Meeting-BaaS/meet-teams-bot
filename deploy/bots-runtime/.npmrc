# @meeting-baas/* packages come from the meeting-baas-packages repository via GitHub Packages.
# NPM_TOKEN: a PAT with read:packages on a developer machine; in CI the run's GITHUB_TOKEN;
# Docker builds get it as a BuildKit secret (see build-image.sh).
@meeting-baas:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
