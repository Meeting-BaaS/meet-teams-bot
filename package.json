{
    "name": "meet-teams-bot",
    "version": "1.0.0",
    "description": "Automated meeting recording bot for Google Meet, Microsoft Teams, and Zoom",
    "keywords": [
        "meeting",
        "recording",
        "bot",
        "automation",
        "google-meet",
        "teams",
        "playwright"
    ],
    "engines": {
        "node": ">= 18.0.0 <=24.0.0"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.873.0",
        "@aws-sdk/client-sqs": "^3.873.0",
        "@aws-sdk/lib-storage": "^3.873.0",
        "@playwright/test": "^1.55.1",
        "async": "^3.2.6",
        "axios": "^1.16.0",
        "axios-retry": "^4.5.0",
        "cloakbrowser": "^0.4.10",
        "dotenv": "^17.2.3",
        "envalid": "^8.1.0",
        "express": "^4.21.0",
        "https-proxy-agent": "^9.0.0",
        "pako": "^2.1.0",
        "protobufjs": "^7.5.8",
        "proxy-chain": "^2.7.1",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "winston": "^3.17.0",
        "ws": "^8.21.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.0",
        "@types/async": "^3.2.24",
        "@types/express": "^4.17.11",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.16.0",
        "@types/ws": "8.5.12",
        "depcheck": "^1.4.7",
        "rimraf": "~3.0.2",
        "ts-jest": "^29.2.5",
        "ts-node-dev": "^2.0.0",
        "ts-unused-exports": "^11.0.1",
        "tsx": "^4.20.6",
        "typescript": "^5.4",
        "unimported": "^1.31.0"
    },
    "overrides": {
        "@babel/core": "^7.29.7",
        "@smithy/config-resolver": "^4.4.0",
        "diff": "^4.0.4",
        "esbuild": "^0.28.1",
        "fast-xml-parser": "^5.7.0",
        "flatted": "^3.4.2",
        "form-data": "^4.0.6",
        "js-yaml": "^4.2.0",
        "lodash": "^4.17.24",
        "minimatch": "^9.0.5",
        "picomatch": "^2.3.2",
        "postcss": "^8.5.10",
        "simple-git": "^3.36.0",
        "uuid": "^11.1.1"
    },
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "start": "node build/src/main.js",
        "clean": "rimraf coverage build tmp",
        "build": "echo '{\"buildDate\": \"'$(date -u +'%Y-%m-%dT%H:%M:%SZ')'\"}' > src/buildInfo.json && ./node_modules/typescript/bin/tsc --skipLibCheck -p tsconfig.release.json",
        "build:bundle": "ts-node src/meeting/meet/network-interception/build-bundle.ts",
        "build:bundle-dev": "OUTPUT_PATH=build/src/meeting/meet/network-interception/bundle/network-interceptor-libs.bundle.js ts-node src/meeting/meet/network-interception/build-bundle.ts",
        "watch": "./node_modules/typescript/bin/tsc --skipLibCheck -w -p tsconfig.release.json",
        "watch-dev": "PROFILE=DEV ts-node-dev --respawn --transpile-only src/main.ts -p tsconfig.release.json",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "check": "biome check --write .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "check:unused-exports": "ts-unused-exports tsconfig.json",
        "check:unused-imports": "unimported",
        "check:unused-deps": "depcheck",
        "check:dead-code": "npm run check:unused-exports && npm run check:unused-imports && npm run check:unused-deps"
    },
    "author": "Meet Teams Bot Contributors",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/yourusername/meet-teams-bot.git"
    },
    "bugs": {
        "url": "https://github.com/yourusername/meet-teams-bot/issues"
    },
    "homepage": "https://github.com/yourusername/meet-teams-bot#readme",
    "volta": {
        "node": "20.18.0"
    }
}
