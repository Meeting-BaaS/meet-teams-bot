{
    "name": "meet-teams-bot",
    "version": "1.0.0",
    "description": "Automated meeting recording bot for Google Meet, Microsoft Teams, and Zoom",
    "keywords": [
        "meeting",
        "recording",
        "bot",
        "automation",
        "google-meet",
        "teams",
        "playwright"
    ],
    "engines": {
        "node": ">= 20.0.0 <=24.0.0"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.873.0",
        "@aws-sdk/client-sqs": "^3.873.0",
        "@aws-sdk/lib-storage": "^3.873.0",
        "@playwright/test": "1.55.1",
        "async": "^3.2.6",
        "axios": "^1.20.0",
        "cloakbrowser": "^0.4.10",
        "express": "^4.21.0",
        "https-proxy-agent": "^9.0.0",
        "pako": "^2.1.0",
        "protobufjs": "^7.6.5",
        "proxy-chain": "^2.7.1",
        "retry-axios": "^2.5.0",
        "tslib": "^2.8.1",
        "winston": "^3.17.0",
        "ws": "^8.21.0",
        "playwright-core": "1.60.0"
    },
    "devDependencies": {
        "@types/async": "^3.2.24",
        "@types/express": "^4.17.11",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.16.0",
        "@types/ws": "8.5.12",
        "depcheck": "^1.4.7",
        "prettier": "3.3.3",
        "rimraf": "~3.0.2",
        "ts-jest": "^29.2.5",
        "ts-node-dev": "^2.0.0",
        "ts-unused-exports": "^11.0.1",
        "typescript": "^5.4",
        "unimported": "^1.31.0",
        "jest": "^29.7.0"
    },
    "scripts": {
        "start": "node build/src/main.js",
        "clean": "rimraf coverage build tmp",
        "build": "echo '{\"buildDate\": \"'$(date -u +'%Y-%m-%dT%H:%M:%SZ')'\"}' > src/buildInfo.json && ./node_modules/typescript/bin/tsc --skipLibCheck -p tsconfig.release.json && npm run build:bundle",
        "watch": "./node_modules/typescript/bin/tsc --skipLibCheck -w -p tsconfig.release.json",
        "watch-dev": "PROFILE=DEV ts-node-dev --respawn --transpile-only src/main.ts -p tsconfig.release.json",
        "format": "prettier --log-level warn --write \"src/**/*.{jsx,js,ts}\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "check:unused-exports": "ts-unused-exports tsconfig.json",
        "check:unused-imports": "unimported",
        "check:unused-deps": "depcheck",
        "check:dead-code": "npm run check:unused-exports && npm run check:unused-imports && npm run check:unused-deps",
        "build:bundle": "OUTPUT_PATH=build/src/meeting/meet/network-interception/bundle/network-interceptor-libs.bundle.js node build/src/meeting/meet/network-interception/build-bundle.js"
    },
    "author": "Meet Teams Bot Contributors",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/yourusername/meet-teams-bot.git"
    },
    "bugs": {
        "url": "https://github.com/yourusername/meet-teams-bot/issues"
    },
    "homepage": "https://github.com/yourusername/meet-teams-bot#readme",
    "volta": {
        "node": "20.18.0"
    },
    "overrides": {
        "playwright": "1.55.1",
        "@playwright/test": "1.55.1",
        "@babel/core": "^7.29.7",
        "@smithy/config-resolver": "^4.4.0",
        "body-parser": "^1.20.6",
        "brace-expansion@<1.1.21": "^1.1.21",
        "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
        "diff": "^4.0.4",
        "esbuild": "^0.28.1",
        "fast-xml-parser": "^5.7.0",
        "flatted": "^3.4.2",
        "form-data": "^4.0.6",
        "ip-address": "^10.7.2",
        "js-yaml": "^4.3.2",
        "lodash": "^4.17.24",
        "minimatch@<3.1.4": "^3.1.5",
        "minimatch@>=5.0.0 <5.1.8": "^5.1.9",
        "minimatch@>=7.0.0 <7.4.8": "^7.4.9",
        "minimatch@>=9.0.0 <9.0.7": "^9.0.9",
        "picomatch": "^2.3.2",
        "postcss": "^8.5.23",
        "simple-git": "^4.0.2",
        "tar": "^7.5.21",
        "uuid": "^11.1.1",
        "ajv@6": "^6.14.0",
        "browserslist": "^4.28.7",
        "nanoid": "^3.3.18",
        "qs": "^6.16.0",
        "yaml@1": "^1.10.3",
        "@simple-git/argv-parser": "^2.0.1",
        "source-map-js": "^1.2.2",
        "proxy-addr": "^2.0.8"
    }
}
