# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# One of error,warn,info,debug. Default: info
LOG_LEVEL=debug

# The base URL of this server. (No trailing slashes)
# During development it would be http://HOST:PORT
# When deploying, it would be your domain like https://api.meetingbaas.com
# Default: http://localhost:3001
API_SERVER_BASEURL=http://localhost:3001

# Whether the bot process is running without a server
# Default: false
SERVERLESS=false

# Configure the path to chrome executable
# Default: /usr/bin/google-chrome
CHROME_PATH=

# AWS Configuration
# This module makes use of AWS SDKs for S3
# The SDK automatically gets credentials from EKS, credentials store or env variables (need to follow AWS standardised variable names)
# The order is defined here - https://docs.aws.amazon.com/sdk-for-javascript/v2/developer-guide/setting-credentials-node.html
# Depending on your environment and configuration, you may want to configure the below (and additional) AWS properties
# Or omit them if using temporary variables exposed through EKS/IAM roles (recommended for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=fr-par
AWS_DEFAULT_REGION=fr-par
AWS_ENDPOINT_URL=https://s3.fr-par.scw.cloud

## S3 Bucket Names
# Logs Bucket. Default name: meeting-baas-logs
AWS_S3_LOGS_BUCKET=
# Artifacts Bucket to store MP4, FLAC, Transcription. Default name: meeting-baas-artifacts
AWS_S3_ARTIFACTS_BUCKET=
# Audio chunks Bucket to store audio chunks. Default name: Default name: meeting-baas-audio-chunks
AWS_S3_AUDIO_CHUNKS_BUCKET=

## Media device name overrides
# Display device. Default: ":99"
# This needs to be present in the env because Playwright relies on this value to be available in the environment when launching Chrome
DISPLAY=":99"
# Pulse audio Virtual speaker monitor. Default Name: virtual_speaker.monitor
VIRTUAL_SPEAKER_MONITOR="virtual_speaker.monitor"
# Pulse audio virtual mic. Default Name: virtual_mic
VIRTUAL_MIC="virtual_mic"
# Pulse audio Virtual speaker. Default: virtual_speaker
VIRTUAL_SPEAKER="virtual_speaker"
# Video device name from v4l2loopback. Default: /dev/video10
VIDEO_DEVICE="/dev/video10"

# EFS Mount Point (for production)
# If upload to S3 fails, files are written to the EFS, ensuring files can be recovered
EFS_MOUNT_POINT=/mnt/efs

## Video Configuration
# Video resolution. Options: 720, 1080. Default: 720
RESOLUTION="720"

# Pulse runtime config paths. This needs to be configured in the environment even though the code isn't using it directly
# Pulse Audio needs the configuration to understand which virtual devices to use
PULSE_RUNTIME_PATH=/tmp/pulse
XDG_RUNTIME_DIR=/tmp/pulse

# Boolean (true/false) - Whether the bot should create and upload audio chunks for the recording (2 hour long chunks) - This is useful if the transcription provider has a duration limit
UPLOAD_AUDIO_CHUNKS=true

# Boolean (true/false) - Whether the bot should upload the raw video captured in the logs bucket. This is useful for debugging
UPLOAD_RAW_VIDEO=false

# Decodo (or similar) backconnect residential proxy used only for Google Meet
# during the join phase. After the bot is admitted the proxy switches off and
# the session goes direct (see src/proxy/toggle-proxy.ts).
#
# The {SESSION} placeholder is substituted at runtime with the bot's UUID
# (hyphens stripped). Each bot pod gets a sticky residential IP while
# different bots naturally land on different IPs from the pool.
#
# Example (Decodo, EU continent):
# RESIDENTIAL_PROXY_TEMPLATE=http://user-<USER>-continent-eu-session-{SESSION}:<PASS>@gate.decodo.com:7000
#
# Leave empty to disable residential proxy (bot joins direct from the pod IP).
RESIDENTIAL_PROXY_TEMPLATE=

# PII redaction for log output (bot.log/logs.log, sound.log,
# speaker_separation.log) is always on. Set to true ONLY as an escape hatch
# for local debugging — never in environments whose logs are uploaded to S3
# or shared with customers.
DISABLE_LOG_PII_REDACTION=false
